{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/manifest.webmanifest",
            "dest": "/public/manifest.webmanifest"
        },
        {
            "src": "/sw.js",
            "dest": "/public/sw.js"
        },
        {
            "src": "/icons/lucky-loop.svg",
            "dest": "/public/icons/lucky-loop.svg"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}